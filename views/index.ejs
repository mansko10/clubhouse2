<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home</title>
  </head>
  <body>
    <% if (locals.currentUser) { %>
      <h1>Welcome <%= locals.currentUser.username  %></h1>
      <a href="/logout">Logout</a>
      <br>
      <a href="/create-new-message">Create new message</a>
      <h1>All messages</h1>
      <ul style="text-decoration: none; padding: 0; list-style-type: none;">
        <% locals.messages.forEach(message => { %>
            <li style="border: 1px solid black; padding: 5px; margin: 10px 0;">
              <p style="margin: 0;"><strong>Title:</strong> <%= message.message_title %></p>
              <p style="margin: 0;"><strong>Text:</strong> <%= message.message_text %></p>
              <p style="margin: 0;"><strong>Author:</strong> hidden</p>
              <p style="margin: 0;"><strong>Posted at:</strong> hidden</p>
            </li>
        <% }) %>
      </ul>
    <% } else { %>
      <a href="/log-in">Log in</a>
      <a href="/sign-up">Sign up</a>

      <h1>All messages</h1>
      <ul style="text-decoration: none; padding: 0; list-style-type: none;">
        <% locals.messages.forEach(message => { %>
            <li style="border: 1px solid black; padding: 5px; margin: 10px 0;">
              <p style="margin: 0;"><strong>Title:</strong> <%= message.message_title %></p>
              <p style="margin: 0;"><strong>Text:</strong> <%= message.message_text %></p>
              <p style="margin: 0;"><strong>Author:</strong> hidden</p>
              <p style="margin: 0;"><strong>Posted at:</strong> hidden</p>
            </li>
        <% }) %>
      </ul>
    <% } %>
  </body>
</html>
