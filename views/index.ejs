<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home</title>
  </head>
  <body>
    <% if (locals.currentUser) { %>
      <h1>Welcome <%= locals.currentUser.username  %></h1>
      <a href="/logout">Logout</a>
    <% } else { %>
      <a href="/log-in">Log in</a>
      <a href="/sign-up">Sign up</a>
    <% } %>
  </body>
</html>
